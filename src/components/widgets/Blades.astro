---
interface BladeItem {
  label: string;
  content: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items: BladeItem[];
  classes?: Record<string, string>;
}

const { title, subtitle, items = [], classes = {} } = Astro.props;
const accordionName = title ? title.toLowerCase().replace(/[^a-z0-9]+/g, '-') : 'blade';
---

<div class:list={[classes?.container ?? '', 'w-full mx-auto']}>
  {
    title && (
      <div class="mb-6">
        <h2 class="text-3xl font-bold tracking-tight dark:text-white">{title}</h2>
        {subtitle && <p class="mt-2 text-muted dark:text-slate-400">{subtitle}</p>}
      </div>
    )
  }

  <!-- Mobile: stacked accordion -->
  <div class="flex flex-col gap-2 md:hidden">
    {
      items.map((item, index) => (
        <details
          open={index === 0}
          name={accordionName}
          class="blade-accordion rounded-xl border border-slate-300 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40 overflow-hidden"
        >
          <summary class="blade-summary flex items-center gap-2 p-3 text-sm font-semibold text-slate-800 dark:text-slate-100 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
            <span class="inline-block h-2 w-2 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500" />
            {item.label}
            <svg
              class="ml-auto h-4 w-4 shrink-0 text-slate-400 transition-transform duration-200"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M6 9l6 6l6 -6" />
            </svg>
          </summary>
          <div class="px-3 pb-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300 border-t border-slate-200 dark:border-slate-600 pt-3">
            <Fragment set:html={item.content} />
          </div>
        </details>
      ))
    }
  </div>

  <!-- Desktop: pills + panel -->
  <div data-blades class="hidden md:flex flex-row gap-5">
    <div
      role="tablist"
      aria-label="Blades"
      class="blade-stack flex flex-col gap-2 w-52 shrink-0 pt-2"
    >
      {
        items.map((item, index) => (
          <button
            type="button"
            role="tab"
            data-blade={index}
            aria-selected={index === 0 ? 'true' : 'false'}
            class="blade relative flex items-center gap-2 whitespace-nowrap rounded-lg border px-4 py-3 text-sm font-semibold text-left transition border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50"
          >
            <span class="blade-notch inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-slate-400 dark:bg-slate-500" />
            {item.label}
          </button>
        ))
      }
    </div>

    <div class="flex-1 min-w-0">
      {
        items.map((item, index) => (
          <div
            data-blade-panel={index}
            role="tabpanel"
            hidden={index !== 0}
            class="rounded-xl border border-slate-300 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40 p-4 sm:p-6 text-sm leading-relaxed text-slate-600 dark:text-slate-300"
            set:html={item.content}
          />
        ))
      }
    </div>
  </div>
</div>

<style is:inline>
  /* Desktop pill active state */
  [data-blade][aria-selected='true'] {
    background: linear-gradient(180deg, #8b5cf6 0%, #6d28d9 100%);
    border-color: transparent;
    color: #fff;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.25),
      0 0 18px -2px rgb(109 40 217 / 0.55);
  }
  [data-blade][aria-selected='true'] .blade-notch {
    background: #ffffff;
    box-shadow: 0 0 6px rgb(255 255 255 / 0.9);
  }
  html.dark [data-blade][aria-selected='true'] {
    background: linear-gradient(180deg, #a78bfa 0%, #7c3aed 100%);
  }

  /* Mobile accordion: rotate chevron when open */
  .blade-accordion[open] > .blade-summary svg {
    transform: rotate(180deg);
  }
  .blade-accordion[open] > .blade-summary .rounded-full {
    background: linear-gradient(180deg, #8b5cf6 0%, #6d28d9 100%);
    box-shadow: 0 0 6px rgb(109 40 217 / 0.6);
  }
  html.dark .blade-accordion[open] > .blade-summary .rounded-full {
    background: linear-gradient(180deg, #a78bfa 0%, #7c3aed 100%);
  }
  .blade-summary:hover {
    background: rgb(241 245 249 / 0.5);
  }
  html.dark .blade-summary:hover {
    background: rgb(30 41 59 / 0.4);
  }
</style>

<script>
  (() => {
    document.querySelectorAll<HTMLElement>('[data-blades]').forEach((root) => {
      const blades = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-blade]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-blade-panel]'));

      const activate = (index: number) => {
        blades.forEach((blade, i) => blade.setAttribute('aria-selected', String(i === index)));
        panels.forEach((panel, i) => {
          panel.hidden = i !== index;
        });
      };

      blades.forEach((blade, index) => {
        blade.addEventListener('click', () => activate(index));

        blade.addEventListener('keydown', (event) => {
          if (!['ArrowRight', 'ArrowLeft', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          let next = index;
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % blades.length;
          else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + blades.length) % blades.length;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = blades.length - 1;
          blades[next].focus();
          activate(next);
        });
      });
    });
  })();
</script>
