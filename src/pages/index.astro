const renderCommunity = (year: CommunityYear) => {
  const months = year.months
    .map((m) => {
      const groups = m.groups
        .map((g) => {
          const items = (g.items ?? [])
            .map((item) => `<li>${item}</li>`)
            .join('');
          return `<p class="mt-2 font-semibold text-slate-700 dark:text-slate-200">${g.name}</p><ul class="list-disc pl-5 space-y-1">${items}</ul>`;
        })
        .join('');
      return `<h4 class="mt-3 text-sm font-bold uppercase tracking-wide text-secondary dark:text-blue-200">${m.month}</h4>${groups}`;
    })
    .join('');
  return `<h3 class="mb-1 text-lg font-bold text-slate-800 dark:text-slate-100">${year.title}</h3>${months}`;
};

