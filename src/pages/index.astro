const PIN = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0-6 0"/><path d="M17.657 16.657L13.414 20.9a2 2 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0"/></svg>';

const renderCommunity = (year: CommunityYear) => {
  const months = year.months
    .map((m) => {
      const events = m.events
        .map((ev) => {
          const body = ev.roles?.length
            ? `<div class="mt-2 flex flex-col gap-2">${ev.roles
                .map(
                  (r) =>
                    `<div class="rounded-md border border-slate-200 dark:border-slate-600 bg-white/40 dark:bg-slate-800/30 p-2"><h5 class="text-xs font-semibold text-slate-700 dark:text-slate-200">${r.name}</h5><ul class="mt-1 list-disc pl-5 space-y-1 text-xs leading-snug text-slate-600 dark:text-slate-300">${(r.items ?? [])
                      .map((item) => `<li>${item}</li>`)
                      .join('')}</ul></div>`
                )
                .join('')}</div>`
            : ev.items?.length
              ? `<ul class="mt-1.5 list-disc pl-5 space-y-1 text-xs leading-snug text-slate-600 dark:text-slate-300">${ev.items
                  .map((item) => `<li>${item}</li>`)
                  .join('')}</ul>`
              : '';
          return `<div class="rounded-lg border border-slate-300 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40 p-3"><div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1"><h4 class="text-sm font-semibold text-slate-800 dark:text-slate-100">${ev.name}</h4><span class="flex shrink-0 items-center gap-1 text-xs text-slate-500 dark:text-slate-400">${PIN}<span>${ev.location}</span></span></div>${body}</div>`;
        })
        .join('');
      return `<h4 class="mt-3 mb-2 text-sm font-bold uppercase tracking-wide text-secondary dark:text-blue-200">${m.month}</h4><div class="flex flex-col gap-2">${events}</div>`;
    })
    .join('');
  return `<h3 class="mb-1 text-lg font-bold text-slate-800 dark:text-slate-100">${year.title}</h3>${months}`;
};



